# Copy this file to .env.local and fill in the values. Never commit .env.local.

# 1) MongoDB Atlas connection string (free M0 cluster works).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=portfolio

# 2) Gmail account that SENDS the notification (can be your own Gmail).
#    Use a Google App Password, not your normal password:
#    Google Account > Security > 2-Step Verification (turn on) > App passwords.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# 3) Inbox that RECEIVES the messages (your Gmail).
CONTACT_TO_EMAIL=your-gmail-address@gmail.com
